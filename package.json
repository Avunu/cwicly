{
  "name": "cwicly",
  "version": "1.0.0",
  "description": "Maintenance version of the Cwicly WordPress plugin for existing websites",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "playground": "npx @wp-playground/cli@latest start --blueprint=blueprint.json",
    "playground:server": "npx @wp-playground/cli@latest server --mount=.:/wordpress/wp-content/plugins/cwicly --blueprint=blueprint.json --login",
    "playground:reset": "npx @wp-playground/cli@latest start --blueprint=blueprint.json --reset",
    "test": "echo \"Error: no test specified\" && exit 1",
    "upgrade": "npx npm-check-updates -u && npm install --force"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StrangeTechDev/cwicly.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/StrangeTechDev/cwicly/issues"
  },
  "homepage": "https://github.com/StrangeTechDev/cwicly#readme",
  "devDependencies": {
    "@wordpress/scripts": "^31.6.0"
  },
  "dependencies": {
    "@wordpress/block-editor": "^15.14.0",
    "@wordpress/data": "^10.41.0",
    "@wordpress/i18n": "^6.14.0"
  }
}
