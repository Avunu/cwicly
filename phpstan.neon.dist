includes:
    # Bootstraps php-stubs/wordpress-stubs and adds WordPress-aware rules
    # (hook callback signatures, dynamic return types, WP constants).
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    # Legacy codebase (~450 files of untyped procedural PHP). Level 0 is the
    # honest baseline: it still catches parse errors, undefined-variable and
    # wrong-arity hook callbacks via the WordPress extension, and the gate is
    # that it stays green. Raise the level as files are cleaned — every bump
    # then shows exactly what the refactor fixed.
    level: 0
    # Some ignore patterns below are safety nets for findings that only appear
    # at higher levels or on specific optional-integration states; do not fail
    # the build when they stop matching.
    reportUnmatchedIgnoredErrors: false
    phpVersion:
        min: 80300
        max: 80400
    paths:
        - cwicly.php
        - core/includes/classes/
        - core/includes/api/
    excludePaths:
        # Vendored third-party libraries and the bundled block definitions / JS
        # artifacts are not analysed. NOTE: these must NOT list anything that also
        # appears in scanDirectories — an excluded path is skipped by symbol
        # discovery too, which would resurrect hundreds of false notFound errors.
        - core/lib/scssphp/*
        - core/includes/acf/*
        - core/includes/js/*
        - vendor/*
    bootstrapFiles:
        - phpstan-bootstrap.php
    # cwicly has no autoloader: every class/function is loaded through
    # require_once chains that need a full ABSPATH. Scanning the directories
    # gives PHPStan the symbol table without executing anything. dynamic/ and
    # helpers/ define the cc_* functions and the legacy global-namespace
    # Cwicly_* classes; lib/svg-sanitizer holds the sanitizer classes referenced
    # from classes/. They are scanned, never analysed, so their own style does
    # not gate the build.
    scanDirectories:
        - core/includes/dynamic/
        - core/includes/helpers/
        - core/includes/blocks/
        # The sanitizer subclasses live at the top of lib/svg-sanitizer/, the
        # upstream enshrined classes under its vendored copy; scssphp's sources
        # sit under src/. All are referenced from analysed code.
        - core/lib/svg-sanitizer/
        - core/lib/scssphp/src/    # PHPDoc types on WordPress boundaries (registry objects, filter payloads)
    # are not runtime-enforced; keep defensive checks without false positives.
    treatPhpDocTypesAsCertain: false
    dynamicConstantNames:
        - CWICLY_VERSION
        - CWICLY_BETA
        - CWICLY_IS_FREE
        - CC_WOOCOMMERCE
        - CWICLY_API_VERSION
        - SCRIPT_DEBUG
        - REST_REQUEST
        - WP_ADMIN
        - WP_DEBUG
    ignoreErrors:
        # Optional integrations: WooCommerce, ACF and Polylang symbols exist only
        # when those plugins are active; every call site is guarded at runtime
        # (CC_WOOCOMMERCE / class_exists('ACF') / function_exists checks).
        -
            message: '#(Class|Function|Constant|Caught class|Instantiated class) ((Automattic\\WooCommerce|WC_|WC|wc_|is_product|get_woocommerce)|acf_|get_field(_object)?|MY_ACF|pll_).* not found#'
        -
            message: '#Parameter \$product of method [\w\\]+::[\w_]+\(\) has invalid type WC_#'
        # Constants cwicly.php defines at runtime from WP state; the bootstrap
        # cannot compute them and neither can PHPStan. (Some are now defined by
        # phpstan-bootstrap.php itself, so this pattern may legitimately stop
        # matching — keep it tolerant rather than deleting the safety net.)
        -
            message: '#Constant (CC_UPLOAD_URL|WORDPRESS_VERSION|CWICLY_THEME_VERSION|CC_CLASSES) not found#'

        # cc_get_head() is declared inside a conditional block in
        # Themer_API (a runtime-only helper wrapping wp_head()); PHPStan cannot
        # see conditionally-declared functions. Same file also trips the
        # "inner named functions" rule on that construct.
        -
            message: '#(Function cc_get_head not found|Inner named functions are not supported)#'
            path: core/includes/api/class-themer-api.php
        # ---- Tracked tech debt, silenced to keep the level-0 gate green. ----
        # Main_Query_API registers render callbacks that reference $attributes /
        # $block without `use` (they work only because of the include scope).
        # Convert to proper closures, then drop this ignore when raising level.
        -
            message: '#Undefined variable: \$(attributes|block|default_template_types)#'
            paths:
                - core/includes/api/class-main-query-api.php
                - core/includes/api/class-backend-api.php
        # Legacy @return docblocks claim array/int but the methods also fall off
        # the end of guard branches. Fix the annotations, not the logic.
        -
            message: '#Method [\w\\]+::[\w_]+\(\) should return .+ but (returns|return statement is missing)#'
        # Hook registrations whose callback arity disagrees with $accepted_args
        # (harmless today: WP passes what it has). Audit each site when raising.
        -
            message: '#Callback expects 1 parameter, \$accepted_args is set to \d#'
        -
            message: '#Action callback returns array but should not return anything#'
        # WooCommerce optional-integration residue beyond the WC_* name match:
        # unknown-class calls through WC() factories and float/string docblock
        # mismatches in price formatting filters.
        -
            message: '#(Call to (static )?method .*\(\) on an unknown class|@param float \$formatted_price does not accept)#'
        # ScssPhp classes are loaded lazily via require_once scss.inc.php (the
        # compiled phar-style entrypoint, not src/) — discovery can't see them.
        -
            message: '#(Instantiated|Caught) class ScssPhp#'
